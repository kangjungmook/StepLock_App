<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACTIVITY_RECOGNITION" />
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission
        android:name="android.permission.PACKAGE_USAGE_STATS"
        tools:ignore="ProtectedPermissions" />
    <uses-permission android:name="android.permission.health.READ_SLEEP" />
    <!--
      광고 ID. AdMob 이 광고를 고르는 데 씁니다. 이 권한을 선언하면 플레이 콘솔
      데이터 안전성에서도 "광고 ID 수집"을 함께 밝혀야 합니다(docs/play-store-checklist.md).
    -->
    <uses-permission android:name="com.google.android.gms.permission.AD_ID" />

    <uses-feature
        android:name="android.hardware.sensor.stepcounter"
        android:required="false" />

    <queries>
        <!-- Android 13 이하에서 Health Connect는 별도 앱이라 조회 대상으로 선언해야 합니다. -->
        <package android:name="com.google.android.apps.healthdata" />

        <!--
          잠글 앱을 사용자가 직접 고르므로 **실행 아이콘이 있는 앱**이 보여야 합니다.
          Android 11 부터 다른 앱은 기본적으로 보이지 않습니다.

          QUERY_ALL_PACKAGES 대신 이 인텐트 선언을 씁니다 — 그 권한은 플레이가 용도를
          따로 심사하고, 잠글 앱을 고르는 데는 실행 가능한 앱만 있으면 충분합니다.
        -->
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
    </queries>

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.StepLock">

        <!--
          AdMob 앱 ID. **이 항목이 없으면 앱이 실행 즉시 죽습니다.**
          값은 admob.properties 나 STEPLOCK_ADMOB_APP_ID 로 주입되고,
          없으면 구글 공식 테스트 ID가 들어갑니다(app/build.gradle.kts).
        -->
        <meta-data
            android:name="com.google.android.gms.ads.APPLICATION_ID"
            android:value="${admobAppId}" />
        <!-- 초기화·광고 로딩을 백그라운드로 밀어 메인 스레드가 멈추지 않게 합니다. -->
        <meta-data
            android:name="com.google.android.gms.ads.flag.OPTIMIZE_INITIALIZATION"
            android:value="true" />
        <meta-data
            android:name="com.google.android.gms.ads.flag.OPTIMIZE_AD_LOADING"
            android:value="true" />

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:launchMode="singleTop"
            android:theme="@style/Theme.StepLock.Splash"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- 소셜 로그인 콜백 — Supabase Auth의 scheme/host와 같아야 합니다. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data
                    android:host="login-callback"
                    android:scheme="steplock" />
            </intent-filter>
            <!-- Health Connect 권한 안내 (Android 13 이하) -->
            <intent-filter>
                <action android:name="androidx.health.ACTION_SHOW_PERMISSIONS_RATIONALE" />
            </intent-filter>
        </activity>

        <!-- Health Connect 권한 안내 (Android 14 이상) -->
        <activity-alias
            android:name="ViewPermissionUsageActivity"
            android:exported="true"
            android:permission="android.permission.START_VIEW_PERMISSION_USAGE"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.VIEW_PERMISSION_USAGE" />
                <category android:name="android.intent.category.HEALTH_PERMISSIONS" />
            </intent-filter>
        </activity-alias>

        <activity
            android:name=".ui.LockActivity"
            android:excludeFromRecents="true"
            android:exported="false"
            android:launchMode="singleInstance"
            android:taskAffinity=""
            android:theme="@style/Theme.StepLock.Lock" />

        <service
            android:name=".service.AppWatchService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="차단한 앱이 열리는지 확인해 잠금 화면을 표시합니다" />
        </service>

        <receiver
            android:name=".service.BootReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>

        <service
            android:name=".service.PomodoroService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="사용자가 시작한 집중 세션의 남은 시간을 세고 알림에 표시합니다" />
        </service>
    </application>

</manifest>
