<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.StepLock" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/steplock_background</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">true</item>
    </style>

    <style name="Theme.StepLock.Lock" parent="Theme.StepLock">
        <item name="android:windowBackground">@color/steplock_dark_background</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>
</resources>
