<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.StepLock" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/steplock_background</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">true</item>
    </style>

    <!--
      앱을 켤 때 뜨는 화면. 설정하지 않으면 그냥 흰 배경이 보입니다.
      Theme.SplashScreen 은 core-splashscreen 이 제공하며, 안드로이드 12 이전
      기기에서도 같은 화면을 보여 줍니다.
    -->
    <style name="Theme.StepLock.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/steplock_background</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_splash_mascot</item>
        <!-- 스플래시가 끝나면 이 테마로 넘어갑니다. -->
        <item name="postSplashScreenTheme">@style/Theme.StepLock</item>
    </style>

    <!-- 잠금 화면에는 스플래시를 두지 않습니다 — 차단한 앱을 열었을 뿐인데
         우리 앱 로고가 먼저 뜨면 무슨 일인지 알 수 없습니다. -->
    <style name="Theme.StepLock.Lock" parent="Theme.StepLock">
        <item name="android:windowBackground">@color/steplock_dark_background</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>
</resources>
