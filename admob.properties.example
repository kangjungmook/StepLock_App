# AdMob 식별자.
#
# 이 파일을 admob.properties 로 복사한 뒤 AdMob 콘솔에서 발급받은 값을 채웁니다.
# admob.properties 는 .gitignore 에 있어서 커밋되지 않습니다.
#
# ── 어느 빌드에 들어가는가 ───────────────────────────────────────────────
#   디버그 APK  : **언제나 구글 테스트 ID.** 이 파일과 무관합니다.
#   릴리스 AAB  : 아래 세 값이 모두 채워져 있으면 실 ID, 하나라도 비면 테스트 ID.
#
# 폰에 깔아서 눌러 보는 건 늘 디버그 APK 라서, 자기 앱의 실 광고를 눌러
# 계정이 정지되는 사고가 이 구분 덕에 구조적으로 막힙니다.
#
# ── GitHub Actions 에서 빌드할 때 ────────────────────────────────────────
# 이 파일은 커밋되지 않으므로 CI 는 보지 못합니다. 저장소 설정에 넣으세요.
#   Settings → Secrets and variables → Actions → **Variables** 탭
#     STEPLOCK_ADMOB_APP_ID / STEPLOCK_ADMOB_REWARDED / STEPLOCK_ADMOB_BANNER
# Secrets 가 아니라 Variables 인 이유: 비밀값이 아니고(APK 를 열면 보입니다),
# 나중에 값을 다시 열어 봐야 오타를 잡을 수 있기 때문입니다.
#
# ── 발급 위치 ───────────────────────────────────────────────────────────
#   앱 ID    : AdMob 콘솔 → 앱 → 앱 설정 → 앱 ID  (물결표 ~ 가 들어갑니다)
#   광고 단위: AdMob 콘솔 → 앱 → 광고 단위        (슬래시 / 가 들어갑니다)

appId=ca-app-pub-0000000000000000~0000000000
# 잠금 화면에서 임시 허용을 한 번 더 받는 리워드 광고
rewardedUnitId=ca-app-pub-0000000000000000/0000000000
# 통계 화면 하단 배너
bannerUnitId=ca-app-pub-0000000000000000/0000000000
