# AdMob 식별자.
#
# 이 파일을 admob.properties 로 복사한 뒤 AdMob 콘솔에서 발급받은 값을 채웁니다.
# admob.properties 는 .gitignore 에 있어서 커밋되지 않습니다.
#
# 이 값들은 비밀값이 아닙니다 — APK 를 열면 그대로 보입니다. 저장소에 두지 않는
# 이유는 계정마다 다르고, 다른 사람이 받아 빌드했을 때 내 계정으로 노출이
# 집계되면 안 되기 때문입니다.
#
# 파일이 없으면 구글 공식 테스트 ID로 빌드됩니다. 개발 중에는 그대로 두세요 —
# 자기 앱의 실제 광고를 직접 누르면 AdMob 계정이 정지될 수 있습니다.
#
# 발급 위치
#   앱 ID    : AdMob 콘솔 → 앱 → 앱 설정 → 앱 ID  (물결표 ~ 가 들어갑니다)
#   광고 단위: AdMob 콘솔 → 앱 → 광고 단위        (슬래시 / 가 들어갑니다)

appId=ca-app-pub-0000000000000000~0000000000
# 잠금 화면에서 임시 허용을 한 번 더 받는 리워드 광고
rewardedUnitId=ca-app-pub-0000000000000000/0000000000
# 통계 화면 하단 배너
bannerUnitId=ca-app-pub-0000000000000000/0000000000
